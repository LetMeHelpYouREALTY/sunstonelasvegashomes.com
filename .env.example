# Copy to `.env` locally. On Vercel, set these in Project Settings → Environment Variables.
# Never commit real secrets.

# Google Search Console HTML tag verification (meta name="google-site-verification")
PUBLIC_GOOGLE_SITE_VERIFICATION=

# NAP and maps — must match Google Business Profile exactly
PUBLIC_SITE_PHONE=
PUBLIC_SITE_STREET=
PUBLIC_SITE_POSTAL=
PUBLIC_SITE_LAT=
PUBLIC_SITE_LNG=
PUBLIC_GOOGLE_MAPS_URL=
PUBLIC_GOOGLE_REVIEWS_URL=

# Canonical host: keep `SITE.website` in src/config.ts aligned with your GSC property (apex vs www).

# Optional: Simplifying the Market RSS (default English feed is built in; override URL if needed)
PUBLIC_KCM_FEED_URL=

# RealScout office listings widget — encoded agent ID from RealScout (defaults to Dr. Jan Duffy if unset)
PUBLIC_REALSCOUT_AGENT_ENCODED_ID=
