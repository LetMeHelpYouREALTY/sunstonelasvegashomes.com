# Copy to `.env` locally. On Vercel, set these in Project Settings → Environment Variables.
# Never commit real secrets.

# Google Search Console HTML tag verification (meta name="google-site-verification")
PUBLIC_GOOGLE_SITE_VERIFICATION=

# NAP and maps — must match Google Business Profile exactly
# Vercel: set for Production (required for live site) and Preview (optional) so
# deploy previews show phone, sticky “Call,” Directions, reviews, and socials.
# Production checklist: set all of these on Vercel so the footer shows phone, Directions, and Google reviews links.
PUBLIC_SITE_PHONE=
PUBLIC_SITE_STREET=
PUBLIC_SITE_POSTAL=
PUBLIC_SITE_LAT=
PUBLIC_SITE_LNG=
PUBLIC_GOOGLE_MAPS_URL=
PUBLIC_GOOGLE_REVIEWS_URL=
# Optional: public Google Business Profile URL (shown in footer + RealEstateAgent sameAs)
PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=

# Optional: GBP-aligned social profiles (footer + blog “Connect” when set)
PUBLIC_SOCIAL_FACEBOOK=
PUBLIC_SOCIAL_LINKEDIN=

# Canonical host: production uses `https://www.sunstonelasvegashomes.com/` (see src/config.ts + vercel.json apex→www redirect). GSC URL-prefix property should match.

# Optional: Simplifying the Market RSS (default English feed is built in; override URL if needed)
PUBLIC_KCM_FEED_URL=

# RealScout — same UMD loads advanced search + office listings (Layout). Override filters per market.
PUBLIC_REALSCOUT_AGENT_ENCODED_ID=
# Optional: sort values come from the RealScout embed generator (e.g. PRICE_LOW). Office “featured”
# spotlighting is primarily curated in RealScout; the widget reflects agent/office rules + these envs.
PUBLIC_REALSCOUT_SORT_ORDER=
PUBLIC_REALSCOUT_LISTING_STATUS=
PUBLIC_REALSCOUT_PROPERTY_TYPES=
PUBLIC_REALSCOUT_PRICE_MIN=
PUBLIC_REALSCOUT_PRICE_MAX=
# ISO dates if you want a listing date window (omit for no filter)
PUBLIC_REALSCOUT_LISTING_DATE_START=
PUBLIC_REALSCOUT_LISTING_DATE_END=
# Set to true only if you want seller-side listings mixed into the grid
PUBLIC_REALSCOUT_INCLUDE_SELLER_LISTINGS=
