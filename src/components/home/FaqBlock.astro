---
import type { FaqEntry } from "@/data/faq-entries";

interface Props {
  entries: FaqEntry[];
  /** When true, render only Q&A (page supplies H1 above the MLS block). */
  hideHeading?: boolean;
}

const { entries, hideHeading = false } = Astro.props;
---

<section
  id="faq"
  class="faq-section"
  aria-labelledby={hideHeading ? undefined : "faq-heading"}
  aria-label={hideHeading ? "FAQ answers" : undefined}
>
  {!hideHeading && (
    <h1 id="faq-heading" class="faq-heading">Frequently asked questions</h1>
  )}
  <div class="faq-list">
    {
      entries.map(entry => (
        <div class="faq-item">
          <h2 class="faq-q">{entry.question}</h2>
          <p>{entry.answer}</p>
        </div>
      ))
    }
  </div>
  <p class="faq-cta">
    Ready to see listings in your range?{" "}
    <a class="faq-cta-link" href="#browse-listings">Open the home search</a>.
  </p>
</section>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .faq-section {
    max-width: 42rem;
    margin: 0 auto 3rem;
    padding: 0 0.5rem;
  }

  .faq-heading {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--primary);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.25rem 1.5rem;
    color: var(--primary);
  }

  .faq-q {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .faq-cta {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--primary);
  }

  .faq-cta-link {
    font-weight: 600;
    color: var(--accent-buyer);
  }
</style>
