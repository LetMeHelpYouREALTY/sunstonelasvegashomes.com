---
import type { FaqEntry } from "@/data/faq-entries";

interface Props {
  entries: FaqEntry[];
  /** When true, render only Q&A (page supplies H1 above the MLS block). */
  hideHeading?: boolean;
}

const { entries, hideHeading = false } = Astro.props;
---

<section
  id="faq"
  class="faq-section"
  aria-labelledby={hideHeading ? undefined : "faq-heading"}
  aria-label={hideHeading ? "FAQ answers" : undefined}
>
  {!hideHeading && (
    <h1 id="faq-heading" class="slv-section-title">Frequently asked questions</h1>
  )}
  <div class="slv-card-grid">
    {
      entries.map(entry => (
        <article class="slv-card">
          <h2 class="slv-card__title">{entry.question}</h2>
          <p class="slv-card__text">{entry.answer}</p>
        </article>
      ))
    }
  </div>
  <p class="faq-cta">
    Ready to see listings in your range?{" "}
    <a class="slv-link" href="#browse-listings">Open the home search</a>.
  </p>
</section>

<style>
  .faq-section {
    max-width: 56rem;
    margin: 0 auto 3rem;
    padding: 0 0.25rem;
  }

  .faq-cta {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.95rem;
  }
</style>
