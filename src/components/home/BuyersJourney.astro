---
import type { KcmFeedItem } from "@/lib/kcm-feed";
import KcmNationalFeedSection from "@/components/home/KcmNationalFeedSection.astro";

interface Props {
  kcmFeedTeaser: KcmFeedItem[];
}

const { kcmFeedTeaser } = Astro.props;
---

<section class="buyer-steps" aria-labelledby="buyer-steps-heading">
  <h2 id="buyer-steps-heading" class="slv-section-title">
    Next steps for home buyers
  </h2>
  <div class="slv-card-grid slv-steps-grid">
    <article class="slv-card slv-step-card">
      <h3 class="slv-card__title">Search live MLS listings</h3>
      <p class="slv-card__text">
        Use the MLS home search at the bottom of this site (or from the
        homepage) to filter by price, property type, and status—then save
        favorites and reach out when you are ready to tour.
      </p>
      <a href="/#browse-listings" class="slv-card__link">Go to home search</a>
    </article>
    <article class="slv-card slv-step-card">
      <h3 class="slv-card__title">Explore Sunstone &amp; Trilogy Sunset</h3>
      <p class="slv-card__text">
        See location, lifestyle context, and what makes these communities a fit
        before you narrow your short list.
      </p>
      <a href="/location/" class="slv-card__link">View location &amp; area</a>
    </article>
    <article class="slv-card slv-step-card">
      <h3 class="slv-card__title">Understand the Las Vegas market</h3>
      <p class="slv-card__text">
        Get context on trends and timing so your offer strategy matches current
        conditions—not last year’s headlines.
      </p>
      <a href="/market/" class="slv-card__link">Las Vegas market overview</a>
    </article>
  </div>
</section>

<section class="pillars slv-card-grid" aria-label="Why buyers choose this guidance">
  <article class="slv-card">
    <h2 class="slv-card__title">Neighborhood intel</h2>
    <p class="slv-card__text">
      Sunstone and Trilogy Sunset inventory, pricing, and what it feels like to
      live here—not generic national headlines.
    </p>
  </article>
  <article class="slv-card">
    <h2 class="slv-card__title">Offer to closing</h2>
    <p class="slv-card__text">
      From first tour through inspection and closing, milestones and paperwork are
      explained in plain language.
    </p>
  </article>
  <article class="slv-card">
    <h2 class="slv-card__title">Your pace</h2>
    <p class="slv-card__text">
      Compare homes, refine your offer strategy, and decide on your timeline—without
      pressure.
    </p>
  </article>
</section>

<KcmNationalFeedSection
  items={kcmFeedTeaser}
  heading="What buyers are reading (national context)"
  intro="Short articles from Simplifying the Market—affordability, offers, and trends (opens in a new tab). Pair these with local guidance for Sunstone and Trilogy Sunset from Dr. Jan Duffy."
  headingId="kcm-teaser-heading"
/>

<style>
  .buyer-steps {
    max-width: 72rem;
    margin: 0 auto 2.5rem;
    padding: 0 0.25rem;
  }

  .pillars {
    max-width: 72rem;
    margin: 2rem auto 3rem;
    padding: 0 0.25rem;
  }
</style>
