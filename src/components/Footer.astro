---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { SITE } from "@/config";
import { getSiteContact } from "@/lib/site-contact";

const currentYear = new Date().getFullYear();
const contact = getSiteContact();

const hasAddress =
  contact.streetAddress.length > 0 && contact.postalCode.length > 0;
const addressLine = hasAddress
  ? `${contact.streetAddress}, ${contact.addressLocality}, ${contact.addressRegion} ${contact.postalCode}`
  : "";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-6 text-center sm:text-left"
  >
    <div class="text-sm leading-relaxed">
      <p class="font-semibold text-foreground">{contact.agentName}</p>
      <p class="text-foreground/90">{contact.brokerageName}</p>
      <p class="mt-1 text-foreground/80">
        Nevada license {contact.licenseNumber}
      </p>
      {
        hasAddress && (
          <p class="mt-2 text-foreground/90">
            {addressLine}
          </p>
        )
      }
      {
        contact.telephone && (
          <p class="mt-2">
            <a
              class="font-medium text-accent underline-offset-2 hover:underline"
              href={`tel:${contact.telephone.replace(/\D/g, "")}`}
            >
              {contact.telephone}
            </a>
          </p>
        )
      }
      <p class="mt-2 text-foreground/80">
        {SITE.desc}
      </p>
      <div class="mt-3 flex flex-wrap justify-center gap-3 sm:justify-start">
        {
          contact.googleMapsUrl && (
            <a
              href={contact.googleMapsUrl}
              class="text-accent underline-offset-2 hover:underline"
              rel="noopener noreferrer"
              target="_blank"
            >
              Directions
            </a>
          )
        }
        {
          contact.googleReviewsUrl && (
            <a
              href={contact.googleReviewsUrl}
              class="text-accent underline-offset-2 hover:underline"
              rel="noopener noreferrer"
              target="_blank"
            >
              Google reviews
            </a>
          )
        }
        {
          contact.googleBusinessProfileUrl && (
            <a
              href={contact.googleBusinessProfileUrl}
              class="text-accent underline-offset-2 hover:underline"
              rel="noopener noreferrer"
              target="_blank"
            >
              Google Business Profile
            </a>
          )
        }
      </div>
      <p class="mt-3 flex flex-wrap justify-center gap-x-3 gap-y-1 text-sm sm:justify-start">
        <a href="/contact/" class="text-accent underline-offset-2 hover:underline"
          >Contact</a
        >
        <span class="text-foreground/40" aria-hidden="true">|</span>
        <a href="/sellers/" class="text-accent underline-offset-2 hover:underline"
          >Sellers</a
        >
        <span class="text-foreground/40" aria-hidden="true">|</span>
        <a href="/privacy/" class="text-accent underline-offset-2 hover:underline"
          >Privacy</a
        >
      </p>
    </div>
    <div
      class="flex flex-col items-center justify-between gap-4 sm:flex-row-reverse sm:items-start"
    >
      <Socials centered />
      <div class="flex flex-col items-center whitespace-nowrap sm:items-start">
        <span>Copyright &#169; {currentYear} {SITE.title}</span>
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
