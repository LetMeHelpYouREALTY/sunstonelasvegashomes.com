---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { getKcmFeedItems } from "@/lib/kcm-feed";
import { getSiteContact } from "@/lib/site-contact";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const kcmFeedTeaser = await getKcmFeedItems(4);

const pageTitle = `${SITE.title} | Sunstone & Trilogy Sunset, Las Vegas`;

const siteOrigin = SITE.website.replace(/\/$/, "");
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${siteOrigin}/#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "What areas does Dr. Jan Duffy serve for Sunstone and Trilogy Sunset real estate?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Dr. Jan Duffy works with buyers and sellers across Las Vegas and Henderson, with a focus on Sunstone and the Trilogy Sunset community. Use the office listings search on this page to browse current MLS inventory in your price range.",
      },
    },
    {
      "@type": "Question",
      name: "How do I search homes for sale in Sunstone or Trilogy Sunset?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use the RealScout office listings widget on this site to filter by price, property type, and listing status. You can adjust the price range and sort order to match your goals before you tour homes.",
      },
    },
    {
      "@type": "Question",
      name: "Which brokerage is Dr. Jan Duffy with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Dr. Jan Duffy is licensed in Nevada (S.0197614.LLC) and affiliated with Berkshire Hathaway HomeServices Nevada Properties.",
      },
    },
    {
      "@type": "Question",
      name: "How can I contact Dr. Jan Duffy about buying or selling?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use the phone number and address in the site footer when you are ready to talk. You can also start with the office listings search and then reach out about tours or a home valuation.",
      },
    },
  ],
};
---

<Layout title={pageTitle} description={SITE.desc} faqSchema={faqSchema}>
  <Header />
  <main id="main-content" data-layout="index">
    <section class="hero" aria-labelledby="home-hero-heading">
      <p class="time-of-day" id="timeOfDay">Good morning, Trilogy Sunset</p>
      <h1 id="home-hero-heading">Trilogy Sunset specialist</h1>
      <p>
        Las Vegas real estate guidance by Dr. Jan Duffy — Sunstone, Trilogy
        Sunset, and nearby communities.
      </p>
      <p class="hero-tagline">
        Search-friendly, fast, and built around your timeline and goals.
      </p>
      <div class="hero-actions">
        <a href="/#browse-listings" class="hero-cta hero-cta--primary">
          Search homes for sale
        </a>
        <a href="/buying-process/" class="hero-cta hero-cta--secondary">
          How buying works
        </a>
        {
          contact.telephone && (
            <a href={telHref} class="hero-cta hero-cta--ghost">
              Call {contact.telephone}
            </a>
          )
        }
      </div>
    </section>

    <section
      class="buyer-steps"
      aria-labelledby="buyer-steps-heading"
    >
      <h2 id="buyer-steps-heading" class="buyer-steps-heading">
        Next steps for home buyers
      </h2>
      <div class="buyer-steps-grid">
        <article class="buyer-step-card">
          <h3 class="buyer-step-title">Search live MLS listings</h3>
          <p class="buyer-step-text">
            Jump to the office search below to filter by price range, property
            type, and status—then save favorites and reach out when you are ready
            to tour.
          </p>
          <a href="/#browse-listings" class="buyer-step-link">
            Go to home search
          </a>
        </article>
        <article class="buyer-step-card">
          <h3 class="buyer-step-title">Explore Sunstone &amp; Trilogy Sunset</h3>
          <p class="buyer-step-text">
            See location, lifestyle context, and what makes these communities a fit
            before you narrow your short list.
          </p>
          <a href="/location/" class="buyer-step-link">
            View location &amp; area
          </a>
        </article>
        <article class="buyer-step-card">
          <h3 class="buyer-step-title">Understand the Las Vegas market</h3>
          <p class="buyer-step-text">
            Get context on trends and timing so your offer strategy matches current
            conditions—not last year’s headlines.
          </p>
          <a href="/market/" class="buyer-step-link">
            Las Vegas market overview
          </a>
        </article>
      </div>
    </section>

    <section class="pillars" aria-label="How we help">
      <div class="pillar">
        <h2 class="pillar-title">Local focus</h2>
        <p>
          Sunstone and Trilogy Sunset inventory, pricing, and neighborhood
          context — not generic national copy.
        </p>
      </div>
      <div class="pillar">
        <h2 class="pillar-title">Clear process</h2>
        <p>
          From first tour to closing, expectations and milestones are explained
          in plain language.
        </p>
      </div>
      <div class="pillar">
        <h2 class="pillar-title">Your pace</h2>
        <p>
          Buy, sell, or plan ahead with a strategy that fits your situation and
          timeline.
        </p>
      </div>
    </section>

    {
      kcmFeedTeaser.length > 0 && (
        <section
          class="kcm-teaser"
          aria-labelledby="kcm-teaser-heading"
        >
          <h2 id="kcm-teaser-heading" class="kcm-teaser-title">
            National market headlines
          </h2>
          <p class="kcm-teaser-intro">
            Articles from{" "}
            <span class="whitespace-nowrap">Simplifying the Market</span> (opens
            in a new tab). For local Sunstone and Trilogy Sunset strategy, talk
            to Dr. Jan Duffy.
          </p>
          <ul class="kcm-teaser-grid">
            {kcmFeedTeaser.map(item => (
              <li>
                <article class="kcm-teaser-card">
                  {item.image && (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="kcm-teaser-img-wrap"
                    >
                      <img
                        src={item.image}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        width={400}
                        height={200}
                        class="kcm-teaser-img"
                      />
                    </a>
                  )}
                  <div class="kcm-teaser-body">
                    <h3 class="kcm-teaser-item-title">
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.title}
                      </a>
                    </h3>
                    {item.excerpt && (
                      <p class="kcm-teaser-excerpt">{item.excerpt}</p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
          <div class="kcm-teaser-cta">
            <LinkButton href="/market-news/">
              More market news
              <IconArrowRight class="inline-block" />
            </LinkButton>
          </div>
        </section>
      )
    }

    <section id="faq" class="faq-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="faq-heading">
        Frequently asked questions
      </h2>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-q">
            What areas does Dr. Jan Duffy serve for Sunstone and Trilogy Sunset
            real estate?
          </h3>
          <p>
            Dr. Jan Duffy works with buyers and sellers across Las Vegas and
            Henderson, with a focus on Sunstone and the Trilogy Sunset community.
            Use the office listings search on this page to browse current MLS
            inventory in your price range.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-q">
            How do I search homes for sale in Sunstone or Trilogy Sunset?
          </h3>
          <p>
            Use the RealScout office listings widget on this site to filter by
            price, property type, and listing status. You can adjust the price
            range and sort order to match your goals before you tour homes.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-q">Which brokerage is Dr. Jan Duffy with?</h3>
          <p>
            Dr. Jan Duffy is licensed in Nevada (S.0197614.LLC) and affiliated
            with Berkshire Hathaway HomeServices Nevada Properties.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-q">
            How can I contact Dr. Jan Duffy about buying or selling?
          </h3>
          <p>
            Use the phone number and address in the site footer when you are
            ready to talk. You can also start with the office listings search
            and then reach out about tours or a home valuation.
          </p>
        </div>
      </div>
      <p class="faq-cta">
        Ready to see listings in your range?{" "}
        <a class="faq-cta-link" href="/#browse-listings">
          Open the home search
        </a>
        .
      </p>
    </section>

    <section id="intro" class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Blog &amp; updates</h2>
      <p class="mt-2">
        Market notes and how-tos for Sunstone, Trilogy Sunset, and Las Vegas
        real estate.
      </p>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="/rss.xml"
        class="mt-4 inline-flex items-center gap-2"
        aria-label="RSS feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="mr-2 mb-1 whitespace-nowrap sm:mb-0">Connect:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const el = document.getElementById("timeOfDay");
    if (el) {
      const hour = new Date().getHours();
      let msg = "Good morning, Trilogy Sunset";
      if (hour >= 12 && hour < 18) msg = "Good afternoon, Trilogy Sunset";
      else if (hour >= 18 || hour < 5) msg = "Good evening, Trilogy Sunset";
      el.textContent = msg;
    }
  });
</script>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --accent-seller: #16b286;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 4rem 2rem 3rem;
    text-align: center;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 1rem;
    }
  }

  .time-of-day {
    font-size: 1.25rem;
    opacity: 0.85;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    margin-top: 1rem;
    font-size: 1.1rem;
    opacity: 0.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .hero-cta--primary {
    background: #fff;
    color: var(--primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .hero-cta--primary:hover {
    transform: translateY(-1px);
  }

  .hero-cta--secondary {
    border: 2px solid rgba(255, 255, 255, 0.9);
    color: #fff;
  }

  .hero-cta--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .hero-cta--ghost {
    color: rgba(255, 255, 255, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.65rem 0.5rem;
  }

  .buyer-steps {
    max-width: 1200px;
    margin: 0 auto 2.5rem;
    padding: 0 0.25rem;
  }

  .buyer-steps-heading {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
    margin: 0 0 1.25rem;
  }

  .buyer-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .buyer-step-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.35rem 1.25rem;
    display: flex;
    flex-direction: column;
    color: var(--primary);
  }

  .buyer-step-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .buyer-step-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    flex: 1;
    opacity: 0.92;
  }

  .buyer-step-link {
    margin-top: 1rem;
    font-weight: 600;
    color: var(--accent-buyer);
    text-decoration: none;
  }

  .buyer-step-link:hover {
    text-decoration: underline;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0 3rem;
  }

  .pillar {
    background: #fff;
    color: var(--primary);
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.5rem 1.25rem;
  }

  .pillar-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .pillar p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .kcm-teaser {
    max-width: 1200px;
    margin: 0 auto 3rem;
    padding: 0 0.25rem;
  }

  .kcm-teaser-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 0.5rem;
  }

  .kcm-teaser-intro {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--primary);
    opacity: 0.9;
    margin: 0 0 1.25rem;
    max-width: 42rem;
  }

  .kcm-teaser-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .kcm-teaser-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    color: var(--primary);
  }

  .kcm-teaser-img-wrap {
    display: block;
    aspect-ratio: 2 / 1;
    background: var(--background);
    overflow: hidden;
  }

  .kcm-teaser-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kcm-teaser-body {
    padding: 1rem 1.15rem 1.15rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .kcm-teaser-item-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .kcm-teaser-item-title a {
    color: inherit;
    text-decoration: none;
  }

  .kcm-teaser-item-title a:hover {
    color: var(--accent-buyer);
    text-decoration: underline;
  }

  .kcm-teaser-excerpt {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.88;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kcm-teaser-cta {
    margin-top: 1.5rem;
    text-align: center;
  }

  .faq-section {
    max-width: 42rem;
    margin: 0 auto 3rem;
    padding: 0 0.5rem;
  }

  .faq-heading {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--primary);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.25rem 1.5rem;
    color: var(--primary);
  }

  .faq-q {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .faq-item p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .faq-cta {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--primary);
  }

  .faq-cta-link {
    font-weight: 600;
    color: var(--accent-buyer);
  }
</style>
