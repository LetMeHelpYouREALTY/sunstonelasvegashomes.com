---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MarketingHero from "@/components/marketing/MarketingHero.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getSocialLinks } from "@/lib/social-links";
import { getSiteContact } from "@/lib/site-contact";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import KcmNationalFeedSection from "@/components/home/KcmNationalFeedSection.astro";
import { getKcmFeedItems } from "@/lib/kcm-feed";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const kcmHomeItems = await getKcmFeedItems(SITE.postPerIndex);

const socialLinks = getSocialLinks();

const pageTitle = `${SITE.title} | Sunstone & Trilogy Sunset, Las Vegas`;
---

<Layout title={pageTitle} description={SITE.desc} omitListingsFooter>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    class="marketing-surface slv-page slv-mobile-pad"
  >
    <MarketingHero
      title="Find your Sunstone or Trilogy Sunset home"
      headingId="home-hero-heading"
      eyebrow="Good morning, Trilogy Sunset"
    >
      <p slot="lede">
        Buyer-focused MLS search, neighborhood context, and a clear path from
        first tour to keys—with Dr. Jan Duffy, Berkshire Hathaway HomeServices
        Nevada Properties.
      </p>
      <p class="slv-marketing-hero__tagline">
        Search listings on your schedule, ask questions when you are ready, and
        move at a pace that fits your life.
      </p>
      <div class="slv-marketing-hero__actions">
        <a href="/#browse-listings" class="slv-cta slv-cta--primary">
          Search MLS listings
        </a>
        <a href="/buyers/" class="slv-cta slv-cta--secondary">
          Home buyer guide
        </a>
        <a href="/faq/" class="slv-cta slv-cta--secondary">FAQ</a>
        <a href="/contact/" class="slv-cta slv-cta--secondary">Contact</a>
        {
          contact.telephone && (
            <a href={telHref} class="slv-cta slv-cta--ghost">
              Call {contact.telephone}
            </a>
          )
        }
      </div>
      <p class="slv-marketing-hero__trust">
        Nevada license {contact.licenseNumber} · {contact.brokerageName}
      </p>
    </MarketingHero>

    <RealScoutListingSection tightTop />

    <section class="start-here" aria-labelledby="start-here-heading">
      <h2 id="start-here-heading" class="slv-section-title">What do you want to do next?</h2>
      <p class="slv-section-sub">
        Pick a path—search homes first, explore the Sunstone masterplan, or get
        answers before you tour.
      </p>
      <div class="slv-card-grid">
        <article class="start-card start-card--emphasis">
          <h3 class="start-card-title">Search &amp; tour homes</h3>
          <p class="start-card-text">
            Live MLS listings and AI-assisted search—filter by price and property
            type, then reach out for tours.
          </p>
          <a href="/#browse-listings" class="start-card-link">Open home search</a>
        </article>
        <article class="start-card start-card--emphasis">
          <h3 class="start-card-title">Sunstone masterplan guide</h3>
          <p class="start-card-text">
            Northwest Las Vegas context, builder collections, and resale vs
            new—without leaving this site.
          </p>
          <a href="/sunstone/" class="start-card-link">Read the Sunstone guide</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Plan your purchase</h3>
          <p class="start-card-text">
            Step-by-step buyer path, neighborhood context, and market reading in
            one place.
          </p>
          <a href="/buyers/" class="start-card-link">Home buyer guide</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Quick answers</h3>
          <p class="start-card-text">
            Service area, brokerage, MLS search, and how to contact Dr. Jan
            Duffy.
          </p>
          <a href="/faq/" class="start-card-link">Read the FAQ</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Get in touch</h3>
          <p class="start-card-text">
            Phone, directions, reviews, and next steps—aligned with Google
            Business Profile.
          </p>
          <a href="/contact/" class="start-card-link">Contact</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Selling a home</h3>
          <p class="start-card-text">
            Pricing, prep, MLS exposure, and what to expect from list to close.
          </p>
          <a href="/sellers/" class="start-card-link">Seller overview</a>
        </article>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-10 pb-6">
            <h2 class="slv-section-title">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {kcmHomeItems.length > 0 && <Hr />}
        </>
      )
    }

    {
      kcmHomeItems.length > 0 && (
        <div class="pt-8 pb-6">
          <KcmNationalFeedSection
            items={kcmHomeItems}
            heading="National market headlines"
            intro="Headlines from the Simplifying the Market RSS feed (Keeping Current Matters). Articles open in a new tab—third-party content for education only; pair with local Las Vegas guidance from Dr. Jan Duffy."
            headingId="home-kcm-heading"
            sectionId="home-market-headlines"
            showDates
          />
        </div>
      )
    }

    <div class="my-6 text-center">
      <LinkButton href="/posts/" class="slv-link">
        All posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>

    <section id="intro" class="slv-panel slv-panel--narrow" style="margin-bottom: 2rem;">
      <h2 class="slv-card__title">Blog &amp; updates</h2>
      <p class="slv-card__text">
        Market notes and how-tos for Sunstone, Trilogy Sunset, and Las Vegas real
        estate—subscribe or connect for more.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="/rss.xml"
          class="slv-link inline-flex items-center gap-2"
          aria-label="RSS feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="scale-125 stroke-[#3a8dde] stroke-3" />
          RSS Feed
        </a>
        {
          socialLinks.length > 0 && (
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
              <span class="text-sm opacity-80">Connect:</span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const el = document.querySelector(".slv-marketing-hero__eyebrow");
    if (el) {
      const hour = new Date().getHours();
      let msg = "Good morning, Trilogy Sunset";
      if (hour >= 12 && hour < 18) msg = "Good afternoon, Trilogy Sunset";
      else if (hour >= 18 || hour < 5) msg = "Good evening, Trilogy Sunset";
      el.textContent = msg;
    }
  });
</script>

<style>
  #featured ul {
    margin-top: 1rem;
  }
</style>
