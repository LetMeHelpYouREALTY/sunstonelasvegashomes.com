---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import Socials from "@/components/astro/Socials.astro";
import LinkButton from "@/components/astro/LinkButton.astro";
import Card from "@/components/astro/Card.astro";
import Hr from "@/components/astro/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Mingalaba
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        AstroPaper is a minimal, responsive, accessible and SEO-friendly Astro
        blog theme. This theme follows best practices and provides accessibility
        out of the box. Light and dark mode are supported by default. Moreover,
        additional color schemes can also be configured.
      </p>
      <p class="mt-2">
        Read the blog posts or check
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://github.com/satnaing/astro-paper#readme"
        >
          README
        </LinkButton> for more info.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="mr-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<style>
:root {
  --primary: #0A2540;
  --accent-buyer: #3A8DDE;
  --accent-seller: #16B286;
  --background: #F7F9FC;
  --box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.hero {
  background: linear-gradient(135deg, var(--primary) 60%, var(--accent-buyer) 100%);
  color: white;
  padding: 4rem 2rem 3rem 2rem;
  text-align: center;
  min-height: 320px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: var(--box-shadow);
}
@media (max-width: 768px) {
  .hero { padding: 2rem 1rem; }
}
.time-of-day {
  font-size: 1.25rem;
  opacity: 0.85;
  margin-bottom: 0.5rem;
}
.metrics {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin: 2rem 0;
}
.metric {
  background: white;
  color: var(--primary);
  border-radius: 1rem;
  box-shadow: var(--box-shadow);
  padding: 1.5rem 2rem;
  min-width: 120px;
  text-align: center;
}
.featured-properties {
  margin: 3rem auto;
  max-width: 1200px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}
</style>

<!-- HERO SECTION -->
<section class="hero">
  <div class="time-of-day" id="timeOfDay">Good Morning, Trilogy Sunset!</div>
  <h1>Trilogy Sunset Specialist</h1>
  <p>Las Vegas Real Estate Authority by Dr. Jan Duffy</p>
  <p style="margin-top:1rem;font-size:1.1rem;opacity:0.9;">Blazing-fast, conversion-focused, and built for your next move.</p>
</section>

<!-- PROPERTY CAROUSEL (React Island Placeholder) -->
<section style="margin:3rem 0;">
  <!-- <PropertyCarousel client:visible /> -->
  <div style="height:220px;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:1rem;box-shadow:var(--box-shadow);color:var(--primary);font-size:1.2rem;">Property Carousel Coming Soon</div>
</section>

<!-- METRICS SECTION -->
<section class="metrics">
  <div class="metric">
    <div style="font-size:2rem;font-weight:bold;">$1.2B+</div>
    <div>Sales Volume</div>
  </div>
  <div class="metric">
    <div style="font-size:2rem;font-weight:bold;">98%</div>
    <div>List-to-Sale Ratio</div>
  </div>
  <div class="metric">
    <div style="font-size:2rem;font-weight:bold;">3x</div>
    <div>Industry Conversion</div>
  </div>
</section>

<!-- FEATURED PROPERTIES (Content Collection Placeholder) -->
<section class="featured-properties">
  <!-- {featuredProperties.map(property => (
    <PropertyCard property={property} />
  ))} -->
  <div style="background:#fff;border-radius:1rem;box-shadow:var(--box-shadow);padding:2rem;text-align:center;">Featured Properties Coming Soon</div>
  <div style="background:#fff;border-radius:1rem;box-shadow:var(--box-shadow);padding:2rem;text-align:center;">Featured Properties Coming Soon</div>
</section>

<script>
// CSS-only time-of-day adaptation (for demo, JS fallback)
const el = document.getElementById('timeOfDay');
if (el) {
  const hour = new Date().getHours();
  let msg = 'Good Morning, Trilogy Sunset!';
  if (hour >= 12 && hour < 18) msg = 'Good Afternoon, Trilogy Sunset!';
  else if (hour >= 18 || hour < 5) msg = 'Good Evening, Trilogy Sunset!';
  el.textContent = msg;
}
</script>
