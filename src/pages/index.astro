---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { getSocialLinks } from "@/lib/social-links";
import { getSiteContact } from "@/lib/site-contact";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialLinks = getSocialLinks();

const pageTitle = `${SITE.title} | Sunstone & Trilogy Sunset, Las Vegas`;
---

<Layout title={pageTitle} description={SITE.desc}>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    class="pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0"
  >
    <section class="hero" aria-labelledby="home-hero-heading">
      <p class="time-of-day" id="timeOfDay">Good morning, Trilogy Sunset</p>
      <h1 id="home-hero-heading">Find your Sunstone or Trilogy Sunset home</h1>
      <p class="hero-lede">
        Buyer-focused MLS search, neighborhood context, and a clear path from
        first tour to keys—with Dr. Jan Duffy, Berkshire Hathaway HomeServices
        Nevada Properties.
      </p>
      <p class="hero-tagline">
        Search listings on your schedule, ask questions when you are ready, and
        move at a pace that fits your life.
      </p>
      <div class="hero-actions">
        <a href="/#browse-listings" class="hero-cta hero-cta--primary">
          Jump to MLS search
        </a>
        <a href="/buyers/" class="hero-cta hero-cta--secondary">
          Home buyer guide
        </a>
        <a href="/faq/" class="hero-cta hero-cta--secondary">FAQ</a>
        {
          contact.telephone && (
            <a href={telHref} class="hero-cta hero-cta--ghost">
              Call {contact.telephone}
            </a>
          )
        }
      </div>
      <p class="hero-trust">
        Nevada license {contact.licenseNumber} · {contact.brokerageName}
      </p>
    </section>

    <section class="start-here" aria-labelledby="start-here-heading">
      <h2 id="start-here-heading" class="start-here-title">Start here</h2>
      <div class="start-here-grid">
        <article class="start-card">
          <h3 class="start-card-title">Search &amp; tour</h3>
          <p class="start-card-text">
            Live MLS listings and AI-assisted search—filter by price and
            property type, then reach out for tours.
          </p>
          <a href="/#browse-listings" class="start-card-link">Open home search</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Plan your purchase</h3>
          <p class="start-card-text">
            Step-by-step buyer path, neighborhood context, and market reading in
            one place.
          </p>
          <a href="/buyers/" class="start-card-link">Home buyer guide</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Quick answers</h3>
          <p class="start-card-text">
            Service area, brokerage, MLS search, and how to contact Dr. Jan
            Duffy.
          </p>
          <a href="/faq/" class="start-card-link">Read the FAQ</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Selling a home</h3>
          <p class="start-card-text">
            Pricing, prep, MLS exposure, and what to expect from list to close.
          </p>
          <a href="/sellers/" class="start-card-link">Seller overview</a>
        </article>
        <article class="start-card">
          <h3 class="start-card-title">Get in touch</h3>
          <p class="start-card-text">
            Phone, directions, reviews, and next steps—aligned with Google
            Business Profile.
          </p>
          <a href="/contact/" class="start-card-link">Contact</a>
        </article>
      </div>
    </section>

    <section id="intro" class="pt-8 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Blog &amp; updates</h2>
      <p class="mt-2">
        Market notes and how-tos for Sunstone, Trilogy Sunset, and Las Vegas
        real estate.
      </p>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="/rss.xml"
        class="mt-4 inline-flex items-center gap-2"
        aria-label="RSS feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      {
        socialLinks.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="mr-2 mb-1 whitespace-nowrap sm:mb-0">Connect:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>

    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    const el = document.getElementById("timeOfDay");
    if (el) {
      const hour = new Date().getHours();
      let msg = "Good morning, Trilogy Sunset";
      if (hour >= 12 && hour < 18) msg = "Good afternoon, Trilogy Sunset";
      else if (hour >= 18 || hour < 5) msg = "Good evening, Trilogy Sunset";
      el.textContent = msg;
    }
  });
</script>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 4rem 2rem 3rem;
    text-align: center;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 1rem;
    }
  }

  .time-of-day {
    font-size: 1.25rem;
    opacity: 0.85;
    margin-bottom: 0.5rem;
  }

  .hero-lede {
    margin: 0.75rem auto 0;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.55;
    opacity: 0.96;
  }

  .hero-tagline {
    margin-top: 1rem;
    font-size: 1.02rem;
    opacity: 0.9;
    max-width: 34rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.75rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background 0.15s ease;
  }

  .hero-cta--primary {
    background: #fff;
    color: var(--primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .hero-cta--primary:hover {
    transform: translateY(-1px);
  }

  .hero-cta--secondary {
    border: 2px solid rgba(255, 255, 255, 0.9);
    color: #fff;
  }

  .hero-cta--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .hero-cta--ghost {
    color: rgba(255, 255, 255, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.65rem 0.5rem;
  }

  .hero-trust {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.45;
    opacity: 0.88;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 480px) {
    .hero-trust {
      font-size: 0.7rem;
      padding: 0 0.25rem;
    }
  }

  .start-here {
    max-width: 1200px;
    margin: 2rem auto 1rem;
    padding: 0 0.25rem;
  }

  .start-here-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
    margin: 0 0 1.25rem;
  }

  .start-here-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .start-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.35rem 1.25rem;
    border: 1px solid rgba(10, 37, 64, 0.06);
    color: var(--primary);
  }

  .start-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .start-card-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    opacity: 0.92;
  }

  .start-card-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--accent-buyer);
    text-decoration: none;
  }

  .start-card-link:hover {
    text-decoration: underline;
  }
</style>
