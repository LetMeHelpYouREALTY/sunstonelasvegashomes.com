---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { uniquePageTitle } from "@/lib/seo-helpers";
import { getSiteContact } from "@/lib/site-contact";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

export function getStaticPaths() {
  return [
    { params: { model: "sunstone" } },
    { params: { model: "trilogy-sunset" } },
  ];
}

const { model } = Astro.params;

const labels: Record<string, string> = {
  sunstone: "Sunstone",
  "trilogy-sunset": "Trilogy Sunset",
};

const label = labels[model] ?? model;

const pageTitle = uniquePageTitle(`${label} model homes`);
const pageDesc = `Explore ${label} floor plans, finishes, and tours with Dr. Jan Duffy — Berkshire Hathaway HomeServices Nevada Properties.`;

const modelIntro: Record<string, string> = {
  sunstone:
    "Sunstone model homes showcase layouts and finishes you can expect in this northwest Las Vegas masterplan. Use models to compare flow, storage, and indoor–outdoor living before you tour active listings that match your budget. See the Sunstone guide for collection context.",
  "trilogy-sunset":
    "Trilogy Sunset model homes highlight how this community packages floor plans and amenities for active-adult living in Las Vegas. Walking the models helps you decide what matters—single-level living, guest space, and how the home supports your daily routine.",
};
const intro = modelIntro[model ?? ""] ?? modelIntro.sunstone;
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main
    id="main-content"
    class:list={[
      "model-page",
      "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
  >
    <section class="model-hero">
      <h1>{label} model portfolio</h1>
      <p>Floor plans, finishes, and tour-ready highlights</p>
    </section>

    <section class="model-content">
      <div class="model-prose">
        <p>{intro}</p>
        <p>
          Start with the <a href="/#browse-listings">MLS home search</a> on this
          site to see current inventory, then ask Dr. Jan Duffy to align model
          visits with real listings. For financing and contingencies, review the
          <a href="/buying-process/">buying process</a> page.           Context on the area is on <a href="/sunstone/">Sunstone guide</a>,{" "}
          <a href="/location/">location</a>, and <a href="/community/">community</a>.
        </p>
        <p>
          {
            telHref ? (
              <span>
                Prefer to talk first? Call <a href={telHref}>{contact.telephone}</a>
                or use the mobile bar
                below.
              </span>
            ) : (
              <span>Use the mobile bar below to search or get connected.</span>
            )
          }
        </p>
      </div>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .model-page {
    min-height: 50vh;
  }
  .model-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 3rem 2rem 2rem;
    text-align: center;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 768px) {
    .model-hero {
      padding: 2rem 1rem;
    }
  }
  .model-content {
    max-width: 900px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }
  .model-prose {
    color: var(--primary);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .model-prose a {
    color: var(--accent-buyer);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .model-prose p + p {
    margin-top: 1rem;
  }
</style>
