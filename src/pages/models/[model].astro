---
// Model Portfolio dynamic route scaffold for Trilogy Sunset Specialist
---

<style>
:root {
  --primary: #0A2540;
  --accent-buyer: #3A8DDE;
  --background: #F7F9FC;
  --box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.model-hero {
  background: linear-gradient(135deg, var(--primary) 60%, var(--accent-buyer) 100%);
  color: white;
  padding: 3rem 2rem 2rem 2rem;
  text-align: center;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: var(--box-shadow);
}
@media (max-width: 768px) {
  .model-hero { padding: 2rem 1rem; }
}
.model-content {
  max-width: 900px;
  margin: 2rem auto;
  background: #fff;
  border-radius: 1rem;
  box-shadow: var(--box-shadow);
  padding: 2rem;
  display: grid;
  gap: 2rem;
}
</style>

<section class="model-hero">
  <h1>Model Portfolio</h1>
  <p>Explore Trilogy Sunset floor plans and 360° tours.</p>
</section>

<section class="model-content">
  <!-- 360° TOUR PLACEHOLDER -->
  <div style="height:200px;display:flex;align-items:center;justify-content:center;background:var(--background);border-radius:0.75rem;box-shadow:var(--box-shadow);color:var(--primary);font-size:1.1rem;">360° Tour Coming Soon</div>
  <div style="text-align:center;color:var(--primary);font-size:1.2rem;">Model details coming soon.</div>
</section> 