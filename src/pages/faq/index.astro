---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import FaqBlock from "@/components/home/FaqBlock.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { getSiteContact } from "@/lib/site-contact";
import { uniquePageTitle } from "@/lib/seo-helpers";
import { SITE } from "@/config";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const hasFooterNap =
  Boolean(contact.telephone) ||
  (Boolean(contact.streetAddress) && Boolean(contact.postalCode));

const faqContactAnswerText = hasFooterNap
  ? "Use the phone number and address in the site footer when you are ready to talk. You can also start with the home search on this site and then reach out about tours or a home valuation."
  : "Start with the home search on this site to browse listings and save favorites. When you are ready to talk, visit the About page for Dr. Jan Duffy's profile and next steps toward tours or a home valuation.";

const siteOrigin = SITE.website.replace(/\/$/, "");

const pageTitle = uniquePageTitle("FAQ — Sunstone & Las Vegas real estate");
const pageDesc =
  "Answers about Sunstone, Trilogy Sunset, MLS search, Dr. Jan Duffy’s Nevada license and brokerage, and how to get in touch.";

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${siteOrigin}/faq/#faq`,
  mainEntity: [
    {
      "@type": "Question",
      name: "What areas does Dr. Jan Duffy serve for Sunstone and Trilogy Sunset real estate?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Dr. Jan Duffy works with buyers and sellers across Las Vegas and Henderson, with a focus on Sunstone and the Trilogy Sunset community. Use the home search on this site to browse current MLS inventory in your price range.",
      },
    },
    {
      "@type": "Question",
      name: "How do I search homes for sale in Sunstone or Trilogy Sunset?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use the RealScout MLS home search on this site to filter by price, property type, and listing status. You can adjust the price range and sort order to match your goals before you tour homes.",
      },
    },
    {
      "@type": "Question",
      name: "Which brokerage is Dr. Jan Duffy with?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Dr. Jan Duffy is licensed in Nevada (S.0197614.LLC) and affiliated with Berkshire Hathaway HomeServices Nevada Properties.",
      },
    },
    {
      "@type": "Question",
      name: "How can I contact Dr. Jan Duffy about buying or selling?",
      acceptedAnswer: {
        "@type": "Answer",
        text: faqContactAnswerText,
      },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDesc} faqSchema={faqSchema}>
  <Header />
  <main
    id="main-content"
    class="faq-page-main pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0"
  >
    <FaqBlock faqContactAnswerText={faqContactAnswerText} />
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  .faq-page-main {
    padding-top: 1.5rem;
  }
</style>
