---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MarketingHero from "@/components/marketing/MarketingHero.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { getSiteContact } from "@/lib/site-contact";
import { uniquePageTitle } from "@/lib/seo-helpers";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle("Lifestyle");
const pageDesc =
  "Lifestyle and amenities near Sunstone and Trilogy Sunset—events, recreation, and day-to-day living in Las Vegas.";
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main id="main-content" class="marketing-surface slv-page slv-mobile-pad">
    <MarketingHero
      title="Lifestyle"
      tagline="What it is like to live in Sunstone and Trilogy Sunset"
    />

    <RealScoutListingSection tightTop />

    <section class="slv-panel slv-prose">
      <p>
        Life in the Las Vegas Valley balances desert climate with strong indoor
        and outdoor amenities—pools, trails, clubhouses, and year-round events
        are common reasons buyers choose master-planned communities like
        Sunstone and Trilogy Sunset in northwest Las Vegas. Weekends might mean
        golf, dining out, or quick trips to the Strip and airport; your routine
        depends on work location and how you like to spend time at home.
      </p>
      <p>
        Pair this page with <a href="/community/" class="slv-link">community</a>, the{" "}
        <a href="/sunstone/" class="slv-link">Sunstone guide</a>, and{" "}
        <a href="/location/" class="slv-link">location</a> for maps and commute framing. When you
        are ready to see homes that match your lifestyle, use the{" "}
        <a href="#browse-listings" class="slv-link">MLS home search</a> and filter with Dr. Jan
        Duffy for tours and offer strategy.
      </p>
      <p>
        For a step-by-step path from pre-approval to keys, read the
        <a href="/buying-process/" class="slv-link">buying process</a> page.
        {
          telHref ? (
            <span>
              Call <a href={telHref} class="slv-link">{contact.telephone}</a> to talk through
              timing and priorities.
            </span>
          ) : null
        }
      </p>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>
