---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { getSiteContact } from "@/lib/site-contact";
import { uniquePageTitle } from "@/lib/seo-helpers";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle("Selling in Sunstone & Las Vegas");
const pageDesc =
  "List and sell Sunstone, Trilogy Sunset, or Las Vegas real estate with Dr. Jan Duffy—pricing, prep, MLS exposure, and closing support. Nevada license S.0197614.LLC.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main
    id="main-content"
    class:list={[
      "sellers-page",
      "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
  >
    <section class="sellers-hero" aria-labelledby="sellers-h1">
      <h1 id="sellers-h1">Selling your home</h1>
      <p class="sellers-lede">
        Sunstone, Trilogy Sunset, and the wider Las Vegas market—with clear
        pricing conversations, MLS exposure, and support from list to close.
      </p>
    </section>

    <section class="sellers-content" aria-label="Seller topics">
      <article class="sellers-card">
        <h2 class="sellers-h2">Pricing &amp; positioning</h2>
        <p>
          We review recent sales and active competition so your list price
          matches today’s market—not last year’s headlines. Adjustments follow
          feedback and timing.
        </p>
      </article>
      <article class="sellers-card">
        <h2 class="sellers-h2">Prep &amp; presentation</h2>
        <p>
          Practical priorities for photos, access, and disclosures so buyers and
          agents see your home at its best.
        </p>
      </article>
      <article class="sellers-card">
        <h2 class="sellers-h2">Exposure</h2>
        <p>
          MLS syndication and coordinated marketing aligned with your brokerage
          and local MLS rules. Buyers often start here—see how we present
          listings on this site.
        </p>
      </article>
      <article class="sellers-card">
        <h2 class="sellers-h2">Next steps</h2>
        <p>
          Read the <a href="/market/">Las Vegas market</a> overview, review
          <a href="/location/">location</a> context for your neighborhood, and
          <a href="/contact/">get in touch</a>
          {telHref ? (
            <>
              {" "}
              or call{" "}
              <a href={telHref} class="sellers-link">
                {contact.telephone}
              </a>
            </>
          ) : (
            ""
          )}
          .
        </p>
        <p class="sellers-note">
          This is general information, not legal or tax advice. Consult
          licensed professionals for your situation.
        </p>
      </article>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .sellers-page {
    min-height: 50vh;
  }

  .sellers-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: #fff;
    padding: 2.5rem 1.5rem;
    text-align: center;
    box-shadow: var(--box-shadow);
  }

  .sellers-hero h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 4vw, 1.85rem);
    font-weight: 700;
  }

  .sellers-lede {
    margin: 0 auto;
    max-width: 38rem;
    font-size: 1.02rem;
    line-height: 1.55;
    opacity: 0.95;
  }

  .sellers-content {
    max-width: 720px;
    margin: 2rem auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sellers-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 1.35rem 1.25rem;
    color: var(--primary);
    border: 1px solid rgba(10, 37, 64, 0.06);
  }

  .sellers-card p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .sellers-card p + p {
    margin-top: 0.75rem;
  }

  .sellers-h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .sellers-link {
    color: var(--accent-buyer);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sellers-note {
    font-size: 0.85rem !important;
    opacity: 0.88;
    margin-top: 0.75rem !important;
  }
</style>
