---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { SITE } from "@/config";
import { getSiteContact } from "@/lib/site-contact";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";
const mapsUrl = contact.googleMapsUrl;

const pageTitle = `Location & amenities | ${SITE.title}`;
const pageDesc =
  "Sunstone and Trilogy Sunset location context—nearby amenities, commute, and lifestyle in Las Vegas with Dr. Jan Duffy.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main
    id="main-content"
    class:list={[
      "location-page",
      "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
  >
    <section class="location-hero">
      <h1>Location advantage</h1>
      <p>Sunstone, Trilogy Sunset, and nearby Las Vegas amenities</p>
    </section>

    <section class="location-content">
      <div class="location-body">
        <p>
          Sunstone and Trilogy Sunset are part of the greater Las Vegas
          metro—buyers often weigh commute, lifestyle amenities, and how each
          community fits day-to-day routines. Use the{" "}
          <a href="/#browse-listings">MLS home search</a> to see what is on the
          market, then plan tours that compare your top neighborhoods side by
          side.
        </p>
        {
          mapsUrl && (
            <p class="location-maps">
              <a
                href={mapsUrl}
                rel="noopener noreferrer"
                target="_blank"
                class="location-maps-link"
              >
                Open directions in Google Maps
              </a>
            </p>
          )
        }
        <ul class="location-bullets">
          <li>
            <strong>Sunstone</strong> — community context and inventory for
            Sunstone buyers are covered in your search filters and tours.
          </li>
          <li>
            <strong>Trilogy Sunset</strong> — active-adult lifestyle and
            neighborhood fit are easier to judge when you compare listings in
            person.
          </li>
          <li>
            <strong>Las Vegas &amp; Henderson</strong> — broader metro options
            stay available when your priorities shift during the search.
          </li>
        </ul>
      </div>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .location-page {
    min-height: 50vh;
  }
  .location-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 3rem 2rem 2rem;
    text-align: center;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 768px) {
    .location-hero {
      padding: 2rem 1rem;
    }
  }
  .location-content {
    max-width: 900px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }
  .location-body p {
    margin: 0 0 1rem;
    line-height: 1.6;
    color: var(--primary);
    font-size: 1rem;
  }
  .location-body a {
    color: var(--accent-buyer);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .location-maps {
    margin: 0 0 1rem;
  }
  .location-maps-link {
    font-size: 1.05rem;
  }
  .location-bullets {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--primary);
    line-height: 1.55;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
