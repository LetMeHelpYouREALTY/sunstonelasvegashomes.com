---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import { SITE } from "@/config";
import { getKcmFeedItems } from "@/lib/kcm-feed";

const pageTitle = `National market news (Simplifying the Market) | ${SITE.title}`;
const pageDesc =
  "Curated national housing headlines from Simplifying the Market (English feed)—read full articles on their site. Local Las Vegas guidance: Dr. Jan Duffy.";

const items = await getKcmFeedItems(30);

function formatDate(d: Date | null): string {
  if (!d) return "";
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main id="main-content" class="marketing-surface slv-page">
    <header class="slv-blog-header">
      <h1>National market news</h1>
      <p>
        Headlines from the Simplifying the Market RSS feed (Keeping Current
        Matters). Click through to read the full article on their site—not
        affiliated content; shared for education only.
      </p>
    </header>

    <RealScoutListingSection tightTop />

    <aside class="slv-attribution" aria-label="Attribution">
      <p><strong>Third-party content</strong></p>
      <p>
        Articles © Simplifying the Market / Keeping Current Matters. Dr. Jan
        Duffy and {SITE.title} do not control or endorse third-party pages.
        For local Las Vegas and Henderson strategy,{" "}
        <a class="slv-link" href="/about/">contact Dr. Jan Duffy</a>.
      </p>
    </aside>

    {
      items.length === 0 ? (
        <p class="slv-prose" style="text-align: center; opacity: 0.85;">
          Market headlines are temporarily unavailable. Please try again later.
        </p>
      ) : (
        <ul class="kcm-teaser-grid" style="list-style: none; margin: 0; padding: 0;">
          {items.map(item => (
            <li>
              <article class="kcm-teaser-card">
                {item.image && (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="kcm-teaser-img-wrap"
                  >
                    <img
                      src={item.image}
                      alt={item.title}
                      loading="lazy"
                      decoding="async"
                      class="kcm-teaser-img"
                      width={800}
                      height={400}
                    />
                  </a>
                )}
                <div class="kcm-teaser-body">
                  {item.pubDate && (
                    <time
                      class="kcm-teaser-date"
                      datetime={item.pubDate.toISOString()}
                    >
                      {formatDate(item.pubDate)}
                    </time>
                  )}
                  <h2 class="kcm-teaser-item-title">
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.title}
                    </a>
                  </h2>
                  {item.excerpt && (
                    <p class="kcm-teaser-excerpt">{item.excerpt}</p>
                  )}
                  <p style="margin-top: auto; padding-top: 0.75rem; margin-bottom: 0;">
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="slv-link"
                    >
                      Read at Simplifying the Market (opens in new tab)
                    </a>
                  </p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<style>
  .kcm-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    max-width: 72rem;
    margin: 0 auto 3rem;
  }

  .kcm-teaser-card {
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--slv-elev-2);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    color: var(--primary);
    border: 1px solid rgba(10, 37, 64, 0.06);
  }

  .kcm-teaser-img-wrap {
    display: block;
    aspect-ratio: 2 / 1;
    background: linear-gradient(
      180deg,
      rgba(10, 37, 64, 0.04) 0%,
      var(--slv-surface) 100%
    );
    overflow: hidden;
    flex-shrink: 0;
  }

  .kcm-teaser-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .kcm-teaser-body {
    padding: 1rem 1.15rem 1.15rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .kcm-teaser-date {
    display: block;
    font-size: 0.8rem;
    line-height: 1.3;
    opacity: 0.75;
    margin-bottom: 0.35rem;
  }

  .kcm-teaser-item-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .kcm-teaser-item-title a {
    color: inherit;
    text-decoration: none;
  }

  .kcm-teaser-item-title a:hover {
    color: var(--accent-buyer);
    text-decoration: underline;
  }

  .kcm-teaser-excerpt {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    opacity: 0.88;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
