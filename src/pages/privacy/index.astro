---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { getSiteContact } from "@/lib/site-contact";
import { uniquePageTitle } from "@/lib/seo-helpers";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle("Privacy");
const pageDesc =
  "How Sunstone Las Vegas Homes handles theme preferences, MLS search tools, and contact. Dr. Jan Duffy, Berkshire Hathaway HomeServices Nevada Properties.";
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main
    id="main-content"
    class:list={[
      "privacy-page",
      "mx-auto max-w-3xl px-4 pb-[calc(5rem+env(safe-area-inset-bottom,0px))] pt-8 md:pb-0",
    ]}
  >
    <h1 class="privacy-h1">Privacy</h1>
    <p class="privacy-lede text-foreground/90">
      This site is operated by {contact.agentName} ({contact.brokerageName},
      Nevada license {contact.licenseNumber}). The summary below describes
      common browser behavior on this site—not legal advice.
    </p>

    <RealScoutListingSection tightTop />

    <section class="privacy-section" aria-labelledby="privacy-local">
      <h2 id="privacy-local">Local storage &amp; theme</h2>
      <p>
        Your browser may store a <strong>theme</strong> preference (light or
        dark) in <code>localStorage</code> so the layout stays consistent when
        you return. We do not use that value to identify you across sites.
      </p>
    </section>

    <section class="privacy-section" aria-labelledby="privacy-third">
      <h2 id="privacy-third">MLS search &amp; listings</h2>
      <p>
        Property search and listings on this site may load through third-party
        tools (for example RealScout). Those providers have their own
        terms and privacy practices. Use the search tools only if you accept
        their normal operation in your browser.
      </p>
    </section>

    <section class="privacy-section" aria-labelledby="privacy-contact">
      <h2 id="privacy-contact">Contacting us</h2>
      <p>
        If you call, email, or message us, we use that information to respond
        to your real estate questions and to follow up as you request. We do
        not sell your contact information.
      </p>
      <p>
        <a href="/contact/" class="privacy-link">Contact page</a>
        {
          telHref && (
            <>
              {" "}
              ·{" "}
              <a href={telHref} class="privacy-link">
                {contact.telephone}
              </a>
            </>
          )
        }
      </p>
    </section>

    <section class="privacy-section" aria-labelledby="privacy-updates">
      <h2 id="privacy-updates">Updates</h2>
      <p>
        We may update this page when the site’s features change. The last
        substantive review is noted in the site repository; for questions,
        reach out via the contact page.
      </p>
    </section>

    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  .privacy-h1 {
    font-size: clamp(1.5rem, 4vw, 1.85rem);
    font-weight: 700;
    color: #0a2540;
    margin: 0 0 0.75rem;
  }

  .privacy-lede {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .privacy-section {
    margin-bottom: 1.5rem;
  }

  .privacy-section h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: #0a2540;
  }

  .privacy-section p {
    margin: 0 0 0.75rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .privacy-section code {
    font-size: 0.9em;
  }

  .privacy-link {
    color: #3a8dde;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
