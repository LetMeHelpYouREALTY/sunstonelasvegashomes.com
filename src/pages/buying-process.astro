---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { SITE } from "@/config";
import { getSiteContact } from "@/lib/site-contact";

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = `Buying process | ${SITE.title}`;
const pageDesc =
  "Step-by-step overview of buying a home in Las Vegas—from pre-approval and tours to offer and closing—with Dr. Jan Duffy.";
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main
    id="main-content"
    class:list={[
      "buying-page",
      "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
  >
    <section class="buying-hero">
      <h1>Buying process</h1>
      <p>What to expect when you purchase in Sunstone or Trilogy Sunset</p>
    </section>

    <RealScoutListingSection tightTop />

    <section class="buying-content" aria-labelledby="buying-steps-title">
      <h2 id="buying-steps-title" class="buying-h2">A practical path from search to keys</h2>
      <ol class="buying-steps">
        <li>
          <strong>Define your budget with a lender.</strong> A pre-approval letter
          clarifies what you can offer and helps you move quickly when the right
          home appears.
        </li>
        <li>
          <strong>Search and short-list homes.</strong> Use the{" "}
          <a href="#browse-listings">MLS home search on this site</a>, then narrow to
          a handful of homes that fit your must-haves.
        </li>
        <li>
          <strong>Tour with a local agent.</strong> Dr. Jan Duffy can coordinate
          showings, spot red flags, and explain how each listing compares to recent
          sales nearby.
        </li>
        <li>
          <strong>Make a competitive offer.</strong> Your offer reflects price,
          contingencies, and timing—aligned with current Las Vegas market norms.
        </li>
        <li>
          <strong>Due diligence and closing.</strong> Inspections, appraisal, and
          final walk-through protect you before you sign at closing.
        </li>
      </ol>
      <p class="buying-closing">
        Questions about Sunstone, Trilogy Sunset, or timing your purchase? Use the
        contact details in the footer to reach Dr. Jan Duffy.
      </p>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .buying-page {
    min-height: 50vh;
  }
  .buying-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 3rem 2rem 2rem;
    text-align: center;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 768px) {
    .buying-hero {
      padding: 2rem 1rem;
    }
  }
  .buying-content {
    max-width: 900px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 2rem;
    display: grid;
    gap: 1.5rem;
  }

  .buying-h2 {
    margin: 0;
    font-size: 1.35rem;
    color: var(--primary);
  }

  .buying-steps {
    margin: 0;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--primary);
    line-height: 1.55;
    font-size: 1rem;
  }

  .buying-steps a {
    color: var(--accent-buyer);
    font-weight: 600;
  }

  .buying-closing {
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(10, 37, 64, 0.12);
    font-size: 0.95rem;
    color: var(--primary);
    line-height: 1.5;
  }
</style>
