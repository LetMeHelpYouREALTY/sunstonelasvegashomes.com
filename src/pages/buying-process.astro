---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const pageTitle = `Buying process | ${SITE.title}`;
const pageDesc =
  "Step-by-step overview of buying a home in Las Vegas—from pre-approval and tours to offer and closing—with Dr. Jan Duffy.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main id="main-content" class="buying-page">
    <section class="buying-hero">
      <h1>Buying process</h1>
      <p>What to expect when you purchase in Sunstone or Trilogy Sunset</p>
    </section>

    <section class="buying-content">
      <div
        style="height:120px;display:flex;align-items:center;justify-content:center;background:var(--background);border-radius:0.75rem;box-shadow:var(--box-shadow);color:var(--primary);font-size:1.1rem;"
      >
        Timeline coming soon
      </div>
      <p style="text-align:center;color:var(--primary);font-size:1.2rem;">
        Step-by-step buyer guide coming soon.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --background: #f7f9fc;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .buying-page {
    min-height: 50vh;
  }
  .buying-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 3rem 2rem 2rem;
    text-align: center;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 768px) {
    .buying-hero {
      padding: 2rem 1rem;
    }
  }
  .buying-content {
    max-width: 900px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }
</style>
