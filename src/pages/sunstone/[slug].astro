---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MarketingHero from "@/components/marketing/MarketingHero.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { uniquePageTitle } from "@/lib/seo-helpers";
import { getSiteContact } from "@/lib/site-contact";
import { getSpokeBySlug, getSunstoneSpokeSlugs } from "@/data/sunstone-content";

export function getStaticPaths() {
  return getSunstoneSpokeSlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const spoke = getSpokeBySlug(slug ?? "");
if (!spoke) {
  throw new Error(`Missing Sunstone spoke: ${slug}`);
}

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle(spoke.pageTitle);
const pageDesc = spoke.metaDescription;
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main id="main-content" class="marketing-surface slv-page slv-mobile-pad">
    <MarketingHero
      title={spoke.h1}
      tagline="Sunstone & Trilogy Sunset — Las Vegas real estate"
    />

    <RealScoutListingSection tightTop />

    <section class="slv-panel slv-prose">
      <p>{spoke.lede}</p>
      {
        spoke.sections.map(section => (
          <div>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </div>
        ))
      }
      <p>
        <a href="/sunstone/" class="slv-link">Sunstone masterplan guide</a>
        {" · "}
        <a href="#browse-listings" class="slv-link">MLS home search</a>
        {" · "}
        <a href="/contact/" class="slv-link">Contact</a>
        {
          telHref ? (
            <>
              {" · "}
              <a href={telHref} class="slv-link">Call {contact.telephone}</a>
            </>
          ) : null
        }
      </p>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>
