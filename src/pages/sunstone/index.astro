---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import MarketingHero from "@/components/marketing/MarketingHero.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { uniquePageTitle } from "@/lib/seo-helpers";
import { getSiteContact } from "@/lib/site-contact";
import {
  SUNSTONE_OFFICIAL_SITE,
  SUNSTONE_INVENTORY_DISCLAIMER,
  sunstoneOfficialLinkText,
} from "@/lib/sunstone-hyperlocal";
import {
  SUNSTONE_PILLAR_DESCRIPTION,
  SUNSTONE_PILLAR_TITLE,
  sunstoneCollections,
  sunstonePillarIntro,
  sunstonePillarSections,
  sunstoneSpokes,
} from "@/data/sunstone-content";

function slugify(heading: string): string {
  return heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle(SUNSTONE_PILLAR_TITLE);
const pageDesc = SUNSTONE_PILLAR_DESCRIPTION;
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main id="main-content" class="marketing-surface slv-page slv-mobile-pad">
    <MarketingHero
      title={SUNSTONE_PILLAR_TITLE}
      tagline="Northwest Las Vegas masterplan context, MLS search, and links to the official community site"
    />

    <RealScoutListingSection tightTop />

    <section class="slv-panel">
      <nav class="slv-toc" aria-label="On this page">
        <h2 class="slv-toc__title">On this page</h2>
        <ul class="slv-toc__list">
          <li><a href="#sunstone-overview">Overview</a></li>
          {
            sunstonePillarSections.map(s => (
              <li>
                <a href={`#${slugify(s.heading)}`}>{s.heading}</a>
              </li>
            ))
          }
          <li><a href="#collections-at-sunstone">Collections at Sunstone</a></li>
          <li><a href="#spoke-pages">Related guides</a></li>
        </ul>
      </nav>

      <div class="slv-prose" id="sunstone-overview">
        {sunstonePillarIntro.map(p => <p>{p}</p>)}
        <p>
          <a href={SUNSTONE_OFFICIAL_SITE} rel="noopener noreferrer" target="_blank" class="slv-link"
            >{sunstoneOfficialLinkText}</a
          >
        </p>
        <p class="slv-meta">{SUNSTONE_INVENTORY_DISCLAIMER}</p>
      </div>

      {
        sunstonePillarSections.map(s => (
          <section class="slv-prose slv-scroll-target" id={slugify(s.heading)} aria-labelledby={`h-${slugify(s.heading)}`}>
            <h2 id={`h-${slugify(s.heading)}`}>{s.heading}</h2>
            {s.body.map(para => (
              <p>{para}</p>
            ))}
          </section>
        ))
      }

      <section class="slv-prose slv-scroll-target" id="collections-at-sunstone" aria-labelledby="collections-heading">
        <h2 id="collections-heading">Collections at Sunstone</h2>
        <p>
          These names appear in public marketing for the masterplan. Availability and pricing change—confirm details on the official site and in MLS.
        </p>
        <ul class="slv-anchor-jump">
          {
            sunstoneCollections.map(c => (
              <li>
                <a href={`#${c.anchorId}`} class="slv-link">{c.title}</a>
              </li>
            ))
          }
        </ul>
        {
          sunstoneCollections.map(c => (
            <div class="slv-scroll-target" id={c.anchorId}>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))
        }
      </section>

      <section class="slv-prose" id="spoke-pages" aria-labelledby="spokes-heading">
        <h2 id="spokes-heading">Related guides</h2>
        <ul style="padding-left: 1.25rem; line-height: 1.55;">
          {
            sunstoneSpokes.map(s => (
              <li>
                <a href={`/sunstone/${s.slug}/`} class="slv-link">{s.h1}</a>
                <span class="slv-meta"> — {s.metaDescription.slice(0, 90)}…</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="slv-prose">
        <p>
          Ready to see listings? <a href="#browse-listings" class="slv-link">Open the MLS home search</a> or <a href="/contact/" class="slv-link">contact</a> Dr. Jan Duffy.
          {
            telHref ? (
              <>
                {" "}
                Call <a href={telHref} class="slv-link">{contact.telephone}</a>.
              </>
            ) : null
          }
        </p>
      </div>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>
