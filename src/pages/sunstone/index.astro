---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import MobileHomeBuyerBar from "@/components/MobileHomeBuyerBar.astro";
import { uniquePageTitle } from "@/lib/seo-helpers";
import { getSiteContact } from "@/lib/site-contact";
import {
  SUNSTONE_OFFICIAL_SITE,
  SUNSTONE_INVENTORY_DISCLAIMER,
  sunstoneOfficialLinkText,
} from "@/lib/sunstone-hyperlocal";
import {
  SUNSTONE_PILLAR_DESCRIPTION,
  SUNSTONE_PILLAR_TITLE,
  sunstoneCollections,
  sunstonePillarIntro,
  sunstonePillarSections,
  sunstoneSpokes,
} from "@/data/sunstone-content";

function slugify(heading: string): string {
  return heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const contact = getSiteContact();
const telHref = contact.telephone
  ? `tel:${contact.telephone.replace(/\D/g, "")}`
  : "";

const pageTitle = uniquePageTitle(SUNSTONE_PILLAR_TITLE);
const pageDesc = SUNSTONE_PILLAR_DESCRIPTION;
---

<Layout title={pageTitle} description={pageDesc} omitListingsFooter>
  <Header />
  <main
    id="main-content"
    class:list={[
      "sunstone-page",
      "pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-0",
    ]}
  >
    <section class="sunstone-hero">
      <h1>{SUNSTONE_PILLAR_TITLE}</h1>
      <p>Northwest Las Vegas masterplan context, MLS search, and links to the official community site</p>
    </section>

    <RealScoutListingSection tightTop />

    <section class="sunstone-content">
      <nav class="sunstone-toc" aria-label="On this page">
        <h2 class="sunstone-toc-title">On this page</h2>
        <ul class="sunstone-toc-list">
          <li><a href="#sunstone-overview">Overview</a></li>
          {
            sunstonePillarSections.map(s => (
              <li>
                <a href={`#${slugify(s.heading)}`}>{s.heading}</a>
              </li>
            ))
          }
          <li><a href="#collections-at-sunstone">Collections at Sunstone</a></li>
          <li><a href="#spoke-pages">Related guides</a></li>
        </ul>
      </nav>

      <div class="sunstone-prose" id="sunstone-overview">
        {sunstonePillarIntro.map(p => <p>{p}</p>)}
        <p class="sunstone-official">
          <a href={SUNSTONE_OFFICIAL_SITE} rel="noopener noreferrer" target="_blank"
            >{sunstoneOfficialLinkText}</a
          >
        </p>
        <p class="sunstone-disclaimer">{SUNSTONE_INVENTORY_DISCLAIMER}</p>
      </div>

      {
        sunstonePillarSections.map(s => (
          <section class="sunstone-section" id={slugify(s.heading)} aria-labelledby={`h-${slugify(s.heading)}`}>
            <h2 id={`h-${slugify(s.heading)}`}>{s.heading}</h2>
            {s.body.map(para => (
              <p>{para}</p>
            ))}
          </section>
        ))
      }

      <section class="sunstone-section" id="collections-at-sunstone" aria-labelledby="collections-heading">
        <h2 id="collections-heading">Collections at Sunstone</h2>
        <p>
          These names appear in public marketing for the masterplan. Availability and pricing change—confirm details on the official site and in MLS.
        </p>
        <ul class="sunstone-anchor-jump">
          {
            sunstoneCollections.map(c => (
              <li>
                <a href={`#${c.anchorId}`}>{c.title}</a>
              </li>
            ))
          }
        </ul>
        {
          sunstoneCollections.map(c => (
            <div class="sunstone-collection" id={c.anchorId}>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))
        }
      </section>

      <section class="sunstone-section" id="spoke-pages" aria-labelledby="spokes-heading">
        <h2 id="spokes-heading">Related guides</h2>
        <ul class="sunstone-spoke-links">
          {
            sunstoneSpokes.map(s => (
              <li>
                <a href={`/sunstone/${s.slug}/`}>{s.h1}</a>
                <span class="sunstone-spoke-meta"> — {s.metaDescription.slice(0, 90)}…</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="sunstone-prose sunstone-closing">
        <p>
          Ready to see listings? <a href="#browse-listings">Open the MLS home search</a> or <a href="/contact/">contact</a> Dr. Jan Duffy.
          {
            telHref ? (
              <>
                {" "}
                Call <a href={telHref}>{contact.telephone}</a>.
              </>
            ) : null
          }
        </p>
      </div>
    </section>
    <MobileHomeBuyerBar telHref={telHref || undefined} />
  </main>
</Layout>

<style>
  :root {
    --primary: #0a2540;
    --accent-buyer: #3a8dde;
    --box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .sunstone-page {
    min-height: 50vh;
  }
  .sunstone-hero {
    background: linear-gradient(
      135deg,
      var(--primary) 60%,
      var(--accent-buyer) 100%
    );
    color: white;
    padding: 3rem 2rem 2rem;
    text-align: center;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: var(--box-shadow);
  }
  @media (max-width: 768px) {
    .sunstone-hero {
      padding: 2rem 1rem;
    }
  }
  .sunstone-content {
    max-width: 900px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
    padding: 2rem;
    display: grid;
    gap: 1.75rem;
  }
  .sunstone-toc {
    border: 1px solid rgba(10, 37, 64, 0.12);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    background: #f7f9fc;
  }
  .sunstone-toc-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--primary);
  }
  .sunstone-toc-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--primary);
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .sunstone-toc-list a {
    color: var(--accent-buyer);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sunstone-prose p,
  .sunstone-section p {
    margin: 0 0 1rem;
    line-height: 1.65;
    color: var(--primary);
    font-size: 1.02rem;
  }
  .sunstone-official a {
    font-weight: 600;
    color: var(--accent-buyer);
  }
  .sunstone-disclaimer {
    font-size: 0.92rem;
    color: var(--primary);
    opacity: 0.92;
  }
  .sunstone-section h2 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--primary);
  }
  .sunstone-section h3 {
    font-size: 1.08rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--primary);
  }
  .sunstone-collection {
    scroll-margin-top: 5rem;
  }
  .sunstone-anchor-jump {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    columns: 2;
    gap: 0.5rem 1.5rem;
    font-size: 0.95rem;
  }
  @media (max-width: 600px) {
    .sunstone-anchor-jump {
      columns: 1;
    }
  }
  .sunstone-anchor-jump a {
    color: var(--accent-buyer);
    font-weight: 600;
  }
  .sunstone-spoke-links {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--primary);
    line-height: 1.55;
  }
  .sunstone-spoke-links a {
    color: var(--accent-buyer);
    font-weight: 600;
  }
  .sunstone-spoke-meta {
    font-size: 0.88rem;
    color: var(--primary);
    opacity: 0.85;
  }
  .sunstone-closing a {
    color: var(--accent-buyer);
    font-weight: 600;
  }
</style>
