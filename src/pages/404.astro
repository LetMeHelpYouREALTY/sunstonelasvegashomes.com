---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import { SITE } from "@/config";
---

<Layout
  title={`Page not found | ${SITE.title}`}
  description="This URL is not on Sunstone Las Vegas Homes. Return home or open the MLS search, buying process, or about page."
  omitListingsFooter
>
  <Header />

  <main
    id="main-content"
    class="marketing-surface slv-page flex flex-1 flex-col items-center py-10"
  >
    <section class="slv-panel slv-panel--narrow text-center" style="margin-top: 1rem;">
      <p class="text-7xl font-bold leading-none text-[#3a8dde] sm:text-8xl">404</p>
      <h1 class="mt-4 text-2xl font-bold sm:text-3xl">Page not found</h1>
      <p class="mt-3 text-base opacity-90">
        That URL is not on this site. Try home, MLS search, or the links below.
      </p>
    </section>

    <RealScoutListingSection tightTop />

    <div class="flex flex-col items-center justify-center">
      <LinkButton
        href="/"
        class="my-6 text-lg font-semibold text-[#3a8dde] underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
      <nav
        class="flex max-w-md flex-col gap-3 text-center sm:flex-row sm:flex-wrap sm:justify-center"
        aria-label="Popular pages"
      >
        <LinkButton
          href="#browse-listings"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          Find homes
        </LinkButton>
        <LinkButton
          href="/buyers/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          Home buyer guide
        </LinkButton>
        <LinkButton
          href="/faq/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          FAQ
        </LinkButton>
        <LinkButton
          href="/buying-process/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          Buying process
        </LinkButton>
        <LinkButton
          href="/about/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          About Dr. Jan Duffy
        </LinkButton>
        <LinkButton
          href="/contact/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          Contact
        </LinkButton>
        <LinkButton
          href="/sellers/"
          class="text-base text-[#3a8dde] underline decoration-dashed underline-offset-8"
        >
          Sellers
        </LinkButton>
      </nav>
    </div>
  </main>
</Layout>
