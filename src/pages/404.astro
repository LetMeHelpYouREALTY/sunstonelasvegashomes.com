---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout
  title={`Page not found | ${SITE.title}`}
  description="This URL is not on Sunstone Las Vegas Homes. Return home or open the MLS search, buying process, or about page."
>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-3xl flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <p class="text-9xl font-bold leading-none text-accent">404</p>
      <h1 class="mt-4 text-2xl sm:text-3xl">Page not found</h1>
      <p class="mt-3 max-w-md text-center text-foreground/80">
        That URL is not on this site. Try home, MLS search, or the links below.
      </p>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
      <nav
        class="flex max-w-md flex-col gap-3 text-center sm:flex-row sm:flex-wrap sm:justify-center"
        aria-label="Popular pages"
      >
        <LinkButton
          href="/#browse-listings"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          Find homes
        </LinkButton>
        <LinkButton
          href="/buyers/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          Home buyer guide
        </LinkButton>
        <LinkButton
          href="/faq/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          FAQ
        </LinkButton>
        <LinkButton
          href="/buying-process/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          Buying process
        </LinkButton>
        <LinkButton
          href="/about/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          About Dr. Jan Duffy
        </LinkButton>
        <LinkButton
          href="/contact/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          Contact
        </LinkButton>
        <LinkButton
          href="/sellers/"
          class="text-base underline decoration-dashed underline-offset-8"
        >
          Sellers
        </LinkButton>
      </nav>
    </div>
  </main>

</Layout>
