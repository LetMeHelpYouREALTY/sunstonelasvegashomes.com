---
import Breadcrumb from "@/components/Breadcrumb.astro";
import RealScoutListingSection from "@/components/home/RealScoutListingSection.astro";
import { SITE } from "@/config";

interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
  /** When false, skip MLS block here (e.g. blog search page keeps footer listings only). Default true. */
  earlyListings?: boolean;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
  earlyListings?: boolean;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;

const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
const earlyListings = props.earlyListings !== false;
---

<Breadcrumb />
<main
  data-backUrl={backUrl}
  id="main-content"
  class="marketing-surface slv-page mx-auto w-full max-w-3xl px-4 pb-8"
>
  <header class="slv-blog-header">
    {
      "titleTransition" in props ? (
        <h1>
          {props.pageTitle[0]}
          <span transition:name={props.titleTransition}>
            {props.pageTitle[1]}
          </span>
        </h1>
      ) : (
        <h1>{props.pageTitle}</h1>
      )
    }
    {props.pageDesc && <p>{props.pageDesc}</p>}
  </header>
  {earlyListings && <RealScoutListingSection tightTop />}
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
